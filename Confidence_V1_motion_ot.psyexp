        <Param val="confidence_marker = 999;&amp;#10;confidence_submitted = 0;&amp;#10;high_or_low = 0;&amp;#10;if ((blockCode !== 2)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="confidence_marker = 999;&amp;#10;confidence_submitted=0;&amp;#10;high_or_low = 0;&amp;#10;&amp;#10;if blockCode!=2: #only display this routine in the final 'one trial' block, denoted as block code 2&amp;#10;    continueRoutine = False;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="mouse_pos = type2_mouse.getPos();&amp;#10;mouse_y = mouse_pos[1];&amp;#10;if mouse_y&gt;.075:&amp;#10;    mouse_y=.075;&amp;#10;&amp;#10;if mouse_y&lt;-.075:&amp;#10;    mouse_y=-.075&amp;#10;marker.setPos((0,mouse_y));" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="mouse_pos = type2_mouse.getPos();&amp;#10;mouse_y = mouse_pos[1];&amp;#10;if ((mouse_y &gt; 0.075)) {&amp;#10;    mouse_y = 0.075;&amp;#10;}&amp;#10;if ((mouse_y &lt; (- 0.075))) {&amp;#10;    mouse_y = (- 0.075);&amp;#10;}&amp;#10;marker.setPos([0, mouse_y]);&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((type2_q_key_resp.keys === &quot;space&quot;)) {&amp;#10;    confidence_submitted = 1;&amp;#10;}&amp;#10;confidence_marker = mouse_y;&amp;#10;/*&amp;#10;if blockCode!=-1:&amp;#10;thisExp.addData('confidence_marker', confidence_marker)&amp;#10;if confidence_marker &gt;= 0.05625:&amp;#10;high_confidence = high_confidence+0.5&amp;#10;if confidence_marker == 0.075:&amp;#10;high_confidence = high_confidence+1&amp;#10;&amp;#10;if confidence_marker &lt;= -0.05625:&amp;#10;low_confidence = low_confidence+0.05&amp;#10;if confidence_marker == 0.05625:&amp;#10;low_confidence = low_confidence+1&amp;#10;*/&amp;#10;if ((blockCode !== (- 1))) {&amp;#10;    psychoJS.experiment.addData(&quot;confidence_marker&quot;, confidence_marker);&amp;#10;}&amp;#10;if ((blockCode === 2)) {&amp;#10;    if ((confidence_marker &gt; 0)) {&amp;#10;        high_or_low = 1;&amp;#10;    }&amp;#10;    if ((confidence_marker &lt; 0)) {&amp;#10;        high_or_low = (- 1);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if type2_q_key_resp.keys =='space':&amp;#10;    confidence_submitted=1;&amp;#10;&amp;#10;confidence_marker = mouse_y;&amp;#10;&amp;#10;'''&amp;#10;if blockCode!=-1:&amp;#10;    thisExp.addData('confidence_marker', confidence_marker)&amp;#10;if confidence_marker &gt;= 0.05625:&amp;#10;    high_confidence = high_confidence+0.5&amp;#10;if confidence_marker == 0.075:&amp;#10;    high_confidence = high_confidence+1&amp;#10;&amp;#10;if confidence_marker &lt;= -0.05625:&amp;#10;    low_confidence = low_confidence+0.05&amp;#10;if confidence_marker == 0.05625:&amp;#10;    low_confidence = low_confidence+1&amp;#10;    '''&amp;#10;    &amp;#10;if blockCode!=-1:&amp;#10;    thisExp.addData('confidence_marker', confidence_marker)&amp;#10;if blockCode == 2:&amp;#10;    if confidence_marker &gt; 0:&amp;#10;        high_or_low = 1 #1 = high conf&amp;#10;    if confidence_marker &lt; 0:&amp;#10;        high_or_low = -1" valType="extendedCode" updates="constant" name="End Routine"/>
