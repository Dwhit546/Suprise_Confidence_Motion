        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="type1_resp = 999;&amp;#10;trial_correct = 999;&amp;#10;if ((type1_key_resp.keys === &quot;1&quot;)) {&amp;#10;    type1_resp = (- 1);&amp;#10;} else {&amp;#10;    if ((type1_key_resp.keys === &quot;2&quot;)) {&amp;#10;        type1_resp = 1;&amp;#10;    }&amp;#10;}&amp;#10;if ((type1_resp === 999)) {&amp;#10;    trial_correct = 999;&amp;#10;} else {&amp;#10;    if ((type1_resp === direction)) {&amp;#10;        trial_correct = 1;&amp;#10;    } else {&amp;#10;        trial_correct = 0;&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;type1_resp&quot;, type1_resp);&amp;#10;psychoJS.experiment.addData(&quot;trial_correct&quot;, trial_correct);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="type1_resp = 999; #placeholder for missed trial&amp;#10;trial_correct = 999;&amp;#10;if type1_key_resp.keys =='1':&amp;#10;    type1_resp = -1;&amp;#10;elif type1_key_resp.keys == '2':&amp;#10;    type1_resp = 1;&amp;#10;&amp;#10;if type1_resp ==999:&amp;#10;    trial_correct = 999;&amp;#10;elif type1_resp ==direction:&amp;#10;    trial_correct = 1;&amp;#10;else:&amp;#10;    trial_correct = 0;&amp;#10;    &amp;#10;thisExp.addData('type1_resp', type1_resp);&amp;#10;thisExp.addData('trial_correct', trial_correct);" valType="extendedCode" updates="constant" name="End Routine"/>
