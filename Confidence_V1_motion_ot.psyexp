        <Param val="if (((trial_correct === 1) &amp;&amp; (high_or_low === 1))) {&amp;#10;    bonus_score += 1;&amp;#10;    bonus_str = &quot;You have earned a 50p bonus! This will be added to your participation payment.Press SPACE to continue.&quot;;&amp;#10;} else {&amp;#10;    if (((trial_correct === 1) &amp;&amp; (high_or_low === (- 1)))) {&amp;#10;        bonus_score += 1;&amp;#10;        bonus_str = &quot;You have earned a 50p bonus!This will be added to your participation payment. Press SPACE to continue.&quot;;&amp;#10;    } else {&amp;#10;        bonus_str = &quot;Sorry, you did not get a bonus. Press SPACE to continue.&quot;;&amp;#10;    }&amp;#10;}&amp;#10;bonus_sum.setText(bonus_str);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;if trial_correct == 1 and high_or_low == 1:&amp;#10;    bonus_score += 1&amp;#10;    bonus_str = 'You have earned a 50p bonus! This will be added to your participation payment.Press SPACE to continue.';&amp;#10;elif trial_correct==1 and high_or_low == -1:&amp;#10;    bonus_score += 1&amp;#10;    bonus_str = 'You have earned a 50p bonus!This will be added to your participation payment. Press SPACE to continue.';&amp;#10;else:&amp;#10;    bonus_str = 'Sorry, you did not get a bonus. Press SPACE to continue.'&amp;#10;&amp;#10;bonus_sum.setText(bonus_str);&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;bonus_score&quot;, bonus_score);&amp;#10;psychoJS.experiment.addData(&quot;high_or_low&quot;, high_or_low);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('bonus_score', bonus_score);&amp;#10;thisExp.addData('high_or_low', high_or_low);" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_9" valType="code" updates="None" name="name"/>
