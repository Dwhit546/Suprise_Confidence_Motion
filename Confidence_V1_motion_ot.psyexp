        <Param val="freq_str = &quot;&quot;;&amp;#10;if ((blockCode &lt; 1)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;if ((blockCode === 1)) {&amp;#10;    freq_str = &quot;In the next block confidence reports will be: \n\n RARE \n\n You won't need to report your confidence on most trials \n\n Press SPACE to begin&quot;;&amp;#10;} else {&amp;#10;    if ((blockCode === 2)) {&amp;#10;        freq_str = &quot;In the next block confidence reports will be: \n\n FREQUENT \n\n You will need to report your confidence on most trials \n\n Press SPACE to begin&quot;;&amp;#10;    }&amp;#10;}&amp;#10;frequency_text.setText(freq_str);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="freq_str = '';&amp;#10;&amp;#10;if blockCode&lt;1:&amp;#10;    continueRoutine = False;&amp;#10;&amp;#10;if blockCode ==1:&amp;#10;    freq_str = &quot;In the next block confidence reports will be: \n\n RARE \n\n You won't need to report your confidence on most trials \n\n Press SPACE to begin&quot; ;&amp;#10;&amp;#10;elif blockCode==2:&amp;#10;    freq_str = &quot;In the next block confidence reports will be: \n\n FREQUENT \n\n You will need to report your confidence on most trials \n\n Press SPACE to begin&quot; ;&amp;#10;&amp;#10;frequency_text.setText(freq_str)" valType="extendedCode" updates="constant" name="Begin Routine"/>
